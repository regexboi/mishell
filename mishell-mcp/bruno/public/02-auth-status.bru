meta {
  name: auth status
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/status
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("response has ok=true", function() {
    const body = res.getBody();
    expect(body.ok).to.equal(true);
  });
}
