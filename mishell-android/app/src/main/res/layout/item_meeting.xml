<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neon_panel"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/meeting_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/cyber_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meeting_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="monospace"
        android:textColor="@color/cyber_text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/meeting_expand_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textColor="@color/cyber_cyan"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/meeting_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/cyber_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
