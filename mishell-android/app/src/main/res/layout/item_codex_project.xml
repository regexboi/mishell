<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_codex_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cyber_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="mishell-android" />

        <TextView
            android:id="@+id/path_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="monospace"
            android:textColor="@color/cyber_text_dim"
            android:textSize="11sp"
            tools:text="/Users/mishca/scripts/mishell/mishell-android" />
    </LinearLayout>

    <TextView
        android:id="@+id/permissions_chip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status_chip"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:textColor="@color/cyber_text"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="workspace-write" />
</LinearLayout>
