<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:padding="12dp"
    tools:context=".ArticleReaderActivity">

    <LinearLayout
        android:id="@+id/header_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_neon_selector"
            android:contentDescription="@string/placeholder_back"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/article_back_symbol"
            android:textAllCaps="false"
            android:textColor="@color/cyber_cyan" />

        <TextView
            android:id="@+id/article_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_neon_panel"
            android:maxLines="2"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:textColor="@color/cyber_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Article title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_link_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/card_neon_selector"
            android:contentDescription="@string/article_open_original"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@string/article_open_link_symbol"
            android:textAllCaps="false"
            android:textColor="@color/cyber_cyan"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/article_meta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="@color/cyber_text_dim"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header_row"
        tools:text="Source • Date" />

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_neon_panel"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/article_meta">

        <TextView
            android:id="@+id/article_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:padding="10dp"
            android:textColor="@color/cyber_text"
            android:textSize="14sp"
            tools:text="Article content..." />
    </ScrollView>

    <LinearLayout
        android:id="@+id/squirt_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_neon_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/article_meta">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/squirt_word_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/squirt_left"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@color/cyber_text_dim"
                android:textSize="40sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/squirt_anchor"
                app:layout_constraintEnd_toStartOf="@+id/squirt_anchor"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/squirt_anchor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/cyber_pink"
                android:textSize="40sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="R" />

            <TextView
                android:id="@+id/squirt_right"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="start"
                android:maxLines="1"
                android:textColor="@color/cyber_text_dim"
                android:textSize="40sp"
                app:layout_constraintBaseline_toBaselineOf="@+id/squirt_anchor"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/squirt_anchor" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/squirt_jump_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/squirt_back_15"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:minWidth="0dp"
                android:text="@string/squirt_back_15"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/squirt_back_5"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:text="@string/squirt_back_5"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/squirt_speed_controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/squirt_speed_down"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/squirt_speed_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp"
                android:fontFamily="monospace"
                android:textColor="@color/cyber_cyan"
                android:textSize="16sp"
                tools:text="420 WPM" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/squirt_speed_up"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/squirt_scrubber_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <SeekBar
                android:id="@+id/squirt_scrubber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1"
                android:progress="0" />

            <TextView
                android:id="@+id/squirt_progress_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/cyber_text_dim"
                android:textSize="12sp"
                tools:text="0/120" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
