<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_neon_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/wispr_compose_input"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_wispr_compose_input"
        android:gravity="top|start"
        android:hint="@string/wispr_modal_hint"
        android:imeOptions="actionSend|flagNoExtractUi"
        android:inputType="textMultiLine|textCapSentences|textAutoCorrect"
        android:maxLines="12"
        android:minLines="6"
        android:padding="12dp"
        android:textColor="@color/cyber_text"
        android:textColorHint="@color/cyber_text_dim"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wispr_compose_cancel"
            style="@style/WisprComposeButtonCancel"
            android:text="@string/wispr_modal_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wispr_compose_send"
            style="@style/WisprComposeButtonSend"
            android:layout_marginStart="8dp"
            android:text="@string/wispr_send" />
    </LinearLayout>

</LinearLayout>
