<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/summary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/cyber_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="monospace"
        android:textColor="@color/cyber_text_dim"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/note_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/codex_approval_note"
        android:textColor="#FFF6D9A8"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/allow_once_button"
            style="@style/WisprComposeButtonSend"
            android:layout_height="44dp"
            android:text="@string/codex_approval_allow_once" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/allow_session_button"
            style="@style/WisprComposeButton"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/codex_approval_allow_session" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decline_button"
            style="@style/WisprComposeButtonCancel"
            android:layout_height="44dp"
            android:text="@string/codex_approval_decline" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/WisprComposeButtonCancel"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="@string/codex_approval_cancel" />
    </LinearLayout>
</LinearLayout>
