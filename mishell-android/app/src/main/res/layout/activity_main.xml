<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:padding="14dp"
    tools:context=".MainActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_left_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.37" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_center_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.77" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_bottom_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.79" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_bottom_split"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.23" />

    <GridLayout
        android:id="@+id/icon_grid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toTopOf="@+id/bottom_banner"
        app:layout_constraintEnd_toStartOf="@+id/guide_left_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/tile_1"
            style="@style/NeonTile"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tile_1_label"
                style="@style/NeonTileClockLabel"
                android:text="@string/tile_home"
                tools:text="09:00 pm" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_2"
            style="@style/NeonTile"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tile_2_icon"
                style="@style/NeonTileIcon"
                android:contentDescription="@string/tile_messages"
                app:srcCompat="@drawable/rss" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_3"
            style="@style/NeonTile"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tile_3_icon"
                style="@style/NeonTileIcon"
                android:contentDescription="@string/tile_tasks"
                app:srcCompat="@drawable/todo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tile_4"
            style="@style/NeonTile"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/tile_4_icon"
                style="@style/NeonTileIcon"
                android:contentDescription="@string/tile_config"
                app:srcCompat="@drawable/gear" />
        </LinearLayout>
    </GridLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/diagnostic_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_neon_panel"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_banner"
        app:layout_constraintEnd_toStartOf="@+id/guide_center_end"
        app:layout_constraintStart_toStartOf="@+id/guide_left_end"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/diagnostic_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diagnostic_title"
            android:textColor="@color/cyber_cyan"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:id="@+id/terminal_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diagnostic_header">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:id="@+id/terminal_idle_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/terminal_shell_left"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="0.7"
                        android:fontFamily="monospace"
                        android:gravity="top|start"
                        android:lineSpacingExtra="3dp"
                        android:paddingTop="4dp"
                        android:textColor="@color/cyber_text_dim"
                        android:textSize="11sp"
                        tools:text="$ mishell --status\nbattery [######----] 64%\nwifi [####-] office-net\nsignal -57 dBm" />

                    <ImageView
                        android:id="@+id/terminal_logo"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="2.0"
                        android:adjustViewBounds="true"
                        android:alpha="0.95"
                        android:contentDescription="@string/mishell_avatar"
                        android:paddingHorizontal="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mishell" />

                    <TextView
                        android:id="@+id/terminal_shell_right"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="0.7"
                        android:fontFamily="monospace"
                        android:gravity="top|end"
                        android:lineSpacingExtra="3dp"
                        android:paddingTop="4dp"
                        android:textColor="@color/cyber_text_dim"
                        android:textSize="11sp"
                        tools:text="next meeting\n09:30 AM • Team sync\nin 42m\n\nTap MIC to start voice input." />
                </LinearLayout>

                <TextView
                    android:id="@+id/terminal_output"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:lineSpacingExtra="3dp"
                    android:paddingTop="4dp"
                    android:textColor="@color/cyber_text_dim"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/squirt_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/diagnostic_header">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/squirt_word_row"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/squirt_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/cyber_text_dim"
                    android:textSize="40sp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/squirt_anchor"
                    app:layout_constraintEnd_toStartOf="@+id/squirt_anchor"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/squirt_anchor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_pink"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="R" />

                <TextView
                    android:id="@+id/squirt_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textColor="@color/cyber_text_dim"
                    android:textSize="40sp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/squirt_anchor"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/squirt_anchor" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/squirt_jump_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/squirt_back_15"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/squirt_back_15"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/squirt_back_5"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="@string/squirt_back_5"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/squirt_speed_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/squirt_speed_down"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/squirt_speed_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="14dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_cyan"
                    android:textSize="16sp"
                    tools:text="420 WPM" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/squirt_speed_up"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/squirt_scrubber_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="6dp">

                <SeekBar
                    android:id="@+id/squirt_scrubber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="1"
                    android:progress="0" />

                <TextView
                    android:id="@+id/squirt_progress_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/cyber_text_dim"
                    android:textSize="12sp"
                    tools:text="0/120" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/right_stack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guide_center_end"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/mic_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/mic_idle"
            android:textColor="@color/cyber_cyan"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/mic_button"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:background="@android:color/transparent"
            android:contentDescription="@string/mic_label"
            android:scaleType="fitCenter"
            android:src="@drawable/witch"
            app:tint="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wispr_input_bar"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/guide_bottom_split"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/wispr_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:hint="@string/wispr_input_hint"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/cyber_text"
            android:textColorHint="@color/cyber_text_dim"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/wispr_send_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@drawable/card_neon_selector"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="@string/wispr_send"
            android:textAllCaps="false"
            android:textColor="@color/cyber_cyan" />
    </LinearLayout>

    <TextView
        android:id="@+id/bottom_banner"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_banner"
        android:ellipsize="marquee"
        android:fadingEdge="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="@font/geist_pixel"
        android:gravity="center_vertical"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingHorizontal="18dp"
        android:singleLine="true"
        android:text="@string/banner_text"
        android:textColor="@color/cyber_text"
        android:textSize="26sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/guide_bottom_split"
        tools:text="BOOTING MISHELL CORE // LISTENING // READY" />

</androidx.constraintlayout.widget.ConstraintLayout>
