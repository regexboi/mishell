<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/back_button"
            style="@style/WisprComposeButtonCancel"
            android:layout_width="wrap_content"
            android:layout_weight="0"
            android:text="@string/placeholder_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/cyber_cyan"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Fix websocket reconnection in Android app" />

            <TextView
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cyber_text_dim"
                android:textSize="12sp"
                tools:text="mishell-android • workspace-write" />
        </LinearLayout>

        <TextView
            android:id="@+id/connection_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:textColor="@color/cyber_text"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Connected" />
    </LinearLayout>

    <TextView
        android:id="@+id/full_access_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_codex_warning_banner"
        android:padding="12dp"
        android:text="@string/codex_full_access_banner"
        android:textColor="#FFF6D9A8"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/error_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_codex_surface"
        android:padding="12dp"
        android:textColor="#FFFF9D9D"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Server overloaded; retry later." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/timeline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_button"
            style="@style/WisprComposeButtonCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0"
            android:text="@string/codex_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/interrupt_button"
            style="@style/WisprComposeButtonCancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="0"
            android:text="@string/codex_interrupt" />

        <EditText
            android:id="@+id/composer_input"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_wispr_compose_input"
            android:gravity="top|start"
            android:hint="@string/codex_composer_hint"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="1"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:textColor="@color/cyber_text"
            android:textColorHint="@color/cyber_text_dim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/send_button"
            style="@style/WisprComposeButtonSend"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_weight="0"
            android:text="@string/wispr_send" />
    </LinearLayout>
</LinearLayout>
