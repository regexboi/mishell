<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Mishell" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:fontFamily">@font/geist_pixel</item>
        <item name="fontFamily">@font/geist_pixel</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/bg_dashboard</item>
    </style>

    <style name="NeonTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@drawable/card_neon_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:minWidth">140dp</item>
        <item name="android:minHeight">110dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="NeonTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/cyber_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NeonTileClockLabel" parent="NeonTileLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cyber_cyan</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">24sp</item>
        <item name="autoSizeMaxTextSize">96sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="NeonTileIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:adjustViewBounds">true</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="NeonDataLine">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/cyber_text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WisprComposeButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/card_neon_selector</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WisprComposeButtonCancel" parent="WisprComposeButton">
        <item name="android:textColor">@color/cyber_text_dim</item>
    </style>

    <style name="WisprComposeButtonSend" parent="WisprComposeButton">
        <item name="android:textColor">@color/cyber_cyan</item>
    </style>
</resources>
